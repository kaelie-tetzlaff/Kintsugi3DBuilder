<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>Kintsugi3D</groupId>
        <artifactId>Kintsugi3DBuilder</artifactId>
        <version>1.7.0</version>
    </parent>
    <artifactId>app</artifactId>

    <packaging>jar</packaging>

    <properties>
        <!-- Defaults for the jlink tooling path so the POM model is complete on any platform
             (Qodana analyzes on Linux where no OS profile activates). The macos/windows
             profiles override these for packaged builds. -->
        <jdk.home>${java.home}</jdk.home>
        <jdk.exe.suffix></jdk.exe.suffix>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>1.12</version>
                <executions>
                    <execution>
                        <id>timestamp-property</id>
                        <goals>
                            <goal>timestamp-property</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <name>current.year</name>
                            <pattern>yyyy</pattern>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Copy the OpenJFX jars (classifier matched to the current OS profile) to
                 target/lib/javafx. These jars are consumed by the jlink step below: the
                 JavaFX modules are linked into the bundled runtime image, which is why
                 this runs in generate-resources, ahead of the prepare-package jlink. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-javafx</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>org.openjfx</includeGroupIds>
                            <outputDirectory>${project.build.directory}/lib/javafx</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <!-- Keep JavaFX out of the shaded jar; JavaFX modules are linked into the
                         bundled runtime image by the jlink step below instead. -->
                    <filters>
                        <filter>
                            <artifact>org.openjfx:*</artifact>
                            <excludes>
                                <exclude>**</exclude>
                            </excludes>
                        </filter>
                    </filters>
                    <transformers>
                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                            <mainClass>kintsugi3d.app.Kintsugi3DBuilder</mainClass>
                        </transformer>
                        <transformer implementation="com.github.edwgiz.mavenShadePlugin.log4j2CacheTransformer.PluginsCacheFileTransformer" />
                    </transformers>
                    <shadedArtifactAttached>true</shadedArtifactAttached>
                </configuration>
                <dependencies>
                    <dependency>
                        <!--suppress MavenModelInspection -->
                        <groupId>com.github.edwgiz</groupId>
                        <!--suppress MavenModelInspection -->
                        <artifactId>maven-shade-plugin.log4j2-cachefile-transformer</artifactId>
                        <!--suppress MavenModelInspection -->
                        <version>2.6.1</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.13.0</version>
                <executions>
                    <!-- Download a JDK image. The JDK is build tooling only: it provides the jmods
                         and jlink binary used to assemble the custom bundled runtime below, and is
                         NOT shipped to end users. A JRE download cannot be used here because the
                         trimmed Temurin JRE image is missing jdk.unsupported.desktop, which
                         javafx.swing requires. -->
                    <execution>
                        <id>download-jdk</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>
                                https://api.adoptium.net/v3/binary/latest/${java.version}/ga/${jre.os}/${jre.arch}/jdk/hotspot/normal/eclipse
                            </url>
                            <outputDirectory>
                                ${project.build.directory}
                            </outputDirectory>
                            <outputFileName>jdk.tar.gz</outputFileName>
                        </configuration>
                    </execution>
                    <!-- Download latest published build of Kinsugi 3D Viewer -->
                    <execution>
                        <id>download-viewer</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>wget</goal>
                        </goals>
                        <configuration>
                            <url>
                                https://github.com/UWStout/Kintsugi3DViewer/releases/download/v${viewer.version}/Kintsugi3DViewer-${viewer.os}.zip
                            </url>
                            <outputDirectory>
                                ${project.build.directory}
                            </outputDirectory>
                            <outputFileName>Kintsugi3DViewer.zip</outputFileName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Unpack the JDK - explicitly invoking tar so that we can use strip-components  -->
                    <execution>
                        <id>unpack-jdk</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/jdk"/>
                                <mkdir dir="${project.build.directory}/jdk"/>
                                <exec executable="tar" failonerror="true">
                                    <arg value="-xzf"/>
                                    <arg value="${project.build.directory}/jdk.tar.gz"/>
                                    <arg value="--strip-components=1"/>
                                    <arg value="-C"/>
                                    <arg value="${project.build.directory}/jdk"/>
                                </exec>
                                <delete file="${project.build.directory}/jdk.tar.gz"/>
                            </target>
                        </configuration>
                    </execution>
                    <!-- Assemble the custom bundled runtime with jlink. The resulting image goes
                         to target/jre (the same directory the distribution assemblies collect) and
                         contains java.se plus the jdk modules the application needs, INCLUDING
                         jdk.unsupported.desktop (required by javafx.swing) and the JavaFX modules
                         themselves, so the launchers need no module-path flags at all. -->
                    <execution>
                        <id>jlink-runtime</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/jre"/>
                                <exec executable="${jdk.home}/bin/jlink${jdk.exe.suffix}" failonerror="true">
                                    <arg value="--add-modules"/>
                                    <arg value="java.se,jdk.unsupported,jdk.unsupported.desktop,jdk.crypto.ec,jdk.crypto.cryptoki,jdk.zipfs,jdk.localedata,javafx.base,javafx.graphics,javafx.controls,javafx.swing,javafx.fxml"/>
                                    <arg value="--module-path"/>
                                    <arg value="${jdk.home}/jmods${path.separator}${project.build.directory}/lib/javafx"/>
                                    <arg value="--output"/>
                                    <arg value="${project.build.directory}/jre"/>
                                    <arg value="--strip-debug"/>
                                    <arg value="--no-man-pages"/>
                                    <arg value="--no-header-files"/>
                                    <arg value="--compress=2"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <!-- Unzip Kintsugi 3D Viewer -->
                    <execution>
                        <id>unpack-viewer</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <unzip
                                        src="${project.build.directory}/Kintsugi3DViewer.zip"
                                        dest="${project.build.directory}/viewer"
                                />
                                <chmod
                                        file="${project.build.directory}/viewer/Kintsugi 3D Viewer.app/Contents/MacOS/Kintsugi 3D Viewer"
                                        perm="755"
                                />
                                <delete file="${project.build.directory}/Kintsugi3DViewer.zip"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Configure which test classes should run. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
                <configuration>
                    <includes>
                        <include>**/SmokeTest.class</include>
                    </includes>
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>**/kintsugi3d-builder-about.txt</include>
                    <include>**/Info.plist</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/kintsugi3d-builder-about.txt</exclude>
                    <exclude>**/Info.plist</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
    <profiles>
        <profile>
            <id>macos</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <!-- macOS JDK archives unpack to <top>/Contents/Home -->
                <jdk.home>${project.build.directory}/jdk/Contents/Home</jdk.home>
                <jdk.exe.suffix></jdk.exe.suffix>
            </properties>
            <build>
                <!-- MacOS: Needs a Maven assembly for MacOS and then the disk image script -->
                <plugins>
                    <plugin>
                        <!-- maven assembly plugin causes warnings in Qodana and needs to be suppressed -->
                        <!--suppress MavenModelInspection -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <!--suppress MavenModelInspection -->
                        <artifactId>maven-assembly-plugin</artifactId>
                        <!--suppress MavenModelInspection -->
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>build-dist-macos</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/main/assembly/distribution-macos.xml</descriptor>
                                    </descriptors>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- Disk image for MacOS -->
                        <groupId>org.codehaus.mojo</groupId>
                        <!--suppress MavenModelInspection -->
                        <artifactId>exec-maven-plugin</artifactId>
                        <!--suppress MavenModelInspection -->
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>create-dmg</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/macos-disk-image.sh</argument>
                                        <argument>Kintsugi 3D Builder ${project.version}</argument>
                                        <argument>${project.build.directory}</argument>
                                        <argument>${project.build.directory}/${project.artifactId}-${project.version}-distribution-macos.zip</argument>
                                        <argument>${project.build.directory}/${project.artifactId}-${project.version}</argument>
                                        <argument>${project.build.directory}/${release-basename}-${project.version}-macos.dmg</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- Workaround to run tests on MacOS -->
                                <id>run-tests-macos</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${skipTests}</skip>
                                    <executable>${java.home}/bin/java</executable>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <classpathScope>test</classpathScope>
                                    <arguments>
                                        <argument>-XstartOnFirstThread</argument>
                                        <argument>-Djava.awt.headless=true</argument>
                                        <argument>-classpath</argument>
                                        <classpath/>
                                        <argument>kintsugi3d.app.test.MainThreadRenderingTestRunner</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- Surefire can't be used to run JUnit tests on MacOS,
                        since MacOS requires OpenGL to be on the first thread.
                        Need to explicitly skip tests on MacOS otherwise they run by default. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.5.6</version>
                        <configuration>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <!-- Windows JDK archives unpack directly into <top> -->
                <jdk.home>${project.build.directory}/jdk</jdk.home>
                <jdk.exe.suffix>.exe</jdk.exe.suffix>
            </properties>
            <build>
                <!-- Windows: Needs Launch4J, a Maven assembly for Windows, and NSIS installer -->
                <plugins>
                    <plugin>
                        <!--suppress MavenModelInspection -->
                        <groupId>com.akathist.maven.plugins.launch4j</groupId>
                        <!--suppress MavenModelInspection -->
                        <artifactId>launch4j-maven-plugin</artifactId>
                        <!--suppress MavenModelInspection -->
                        <version>2.1.2</version>
                        <executions>
                            <execution>
                                <id>l4j-clui</id>
                                <phase>package</phase>
                                <goals><goal>launch4j</goal></goals>
                                <configuration>
                                    <headerType>gui</headerType>
                                    <outfile>${project.build.directory}/${release-basename}.exe</outfile>
                                    <jar>${project.build.directory}/${project.artifactId}-${project.version}-shaded.jar</jar>
                                    <icon>${project.basedir}/Kintsugi3D.ico</icon>
                                    <downloadUrl>https://adoptium.net/temurin/releases/?version=11</downloadUrl>
                                    <chdir>.</chdir>
                                    <stayAlive>true</stayAlive>
                                    <jre>
                                        <path>jre;%JAVA_HOME%;%PATH%</path>
                                        <minVersion>11.0.0</minVersion>
                                        <maxVersion>11.99.99</maxVersion>
                                    </jre>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- maven assembly plugin causes warnings in Qodana and needs to be suppressed -->
                        <!--suppress MavenModelInspection -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <!--suppress MavenModelInspection -->
                        <artifactId>maven-assembly-plugin</artifactId>
                        <!--suppress MavenModelInspection -->
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>build-dist-zip</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/main/assembly/distribution.xml</descriptor>
                                    </descriptors>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Unzip the distribution.zip for bundling into the NSIS installer -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>unpack-distribution</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <unzip
                                                src="${project.build.directory}/${project.artifactId}-${project.version}-distribution.zip"
                                                dest="${project.build.directory}/distribution">
                                            <cutdirsmapper dirs="1"/>
                                        </unzip>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!--suppress MavenModelInspection -->
                        <groupId>org.digitalmediaserver</groupId>
                        <!--suppress MavenModelInspection -->
                        <artifactId>nsis-maven-plugin</artifactId>
                        <!--suppress MavenModelInspection -->
                        <version>1.0.3</version>
                        <configuration>
                            <injectHeaderFile>true</injectHeaderFile>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-windows-installer</id>
                                <phase>install</phase>
                                <configuration>
                                    <scriptFile>${project.basedir}/installer.nsi</scriptFile>
                                    <outputFile>${release-basename}-${project.version}-setup.exe</outputFile>
                                </configuration>
                                <goals>
                                    <goal>generate-headerfile</goal>
                                    <goal>make</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
    <dependencies>
        <dependency>
            <groupId>Kintsugi3D</groupId>
            <artifactId>builder</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>Kintsugi3D</groupId>
            <artifactId>fx</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>Kintsugi3D</groupId>
            <artifactId>gl</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>Kintsugi3D</groupId>
            <artifactId>render-export</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>

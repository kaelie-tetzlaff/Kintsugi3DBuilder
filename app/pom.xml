    <artifactId>app</artifactId>

    <packaging>jar</packaging>

    <properties>
        <!-- Defaults for the jlink tooling path so the POM model is complete on any platform
             (Qodana analyzes on Linux where no OS profile activates). The macos/windows
             profiles override these for packaged builds. -->
        <jdk.home>${java.home}</jdk.home>
        <jdk.exe.suffix></jdk.exe.suffix>
    </properties>

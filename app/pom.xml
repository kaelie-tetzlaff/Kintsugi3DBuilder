            <!-- Copy the OpenJFX jars (classifier matched to the current OS profile) to
                 target/lib/javafx. These jars are an input to the jlink step below (JavaFX
                 modules are linked into the bundled runtime image) and are also used by the
                 IDE run configuration's JPMS module path.
                 Runs in generate-resources so the IDE run configuration (whose BeforeRunTask
                 invokes this goal) has the module-path jars available without a full package. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-javafx</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeGroupIds>org.openjfx</includeGroupIds>
                            <outputDirectory>${project.build.directory}/lib/javafx</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
